# Generated code under packages/ is byte-compared by `npm run check`, so a Windows
# checkout must produce the same bytes as CI does on Linux — LF, whatever core.autocrlf
# is set to.
* text=auto eol=lf

# Conformance gold fixtures: never line-ending convert.
*.parquet binary

*.{cmd,[cC][mM][dD]} text eol=crlf
*.{bat,[bB][aA][tT]} text eol=crlf
